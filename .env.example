# Copy to backend/.env and fill in real values.

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=maverickmanju

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=maverickmanju

# openssl rand -base64 48
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=10080

# Seeded on first boot only. Change the password from Admin -> Settings afterwards.
ADMIN_EMAIL=admin@maverickmanju.in
ADMIN_PASSWORD=change-me
ADMIN_NAME=Maverick Manju

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ORIGIN_REGEX=https://.*\.vercel\.app|https://([a-z0-9-]+\.)?maverickmanju\.in
MAX_UPLOAD_MB=100
